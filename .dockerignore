# The worker needs its source entrypoint and conversion libraries. Keep the
# other scripts out of the context and never send a downloaded tool archive.
scripts/*
!scripts/chibi-worker.ts
!scripts/chibi-runtime.ts
!scripts/chibi-preflight.ts
!scripts/chibi-baad.ts
!scripts/chibi-docker-entrypoint.sh
!scripts/chibi/
!scripts/chibi/**
!scripts/chibi-postprocess.mjs
!scripts/chibi-halo-follow.mjs
!scripts/chibi-incomplete-materials.mjs
!scripts/chibi-face-events.mjs
!scripts/chibi-root-rotations.mjs
!scripts/chibi-renderer-active.mjs
!scripts/chibi-face-skin.mjs
!scripts/chibi-alternate-hair.mjs
!scripts/chibi_v12_motion_proof_unitypy.py
!scripts/chibi-tools/
!scripts/chibi-tools/**
